#include <iostream>
using namespace std;

class Course {
public:
    virtual void duration() = 0;
};

class OnlineCourse : public Course {
private:
    int weeks;
    int hoursPerWeek;
public:
    OnlineCourse(int w, int h) {
        weeks = w;
        hoursPerWeek = h;
    }

    void duration() override {
        cout << "Online Course Duration: "
            << weeks << " weeks" << endl;

        cout << "Total Study Hours: "
            << weeks * hoursPerWeek << " hours" << endl;
    }
};

class OfflineCourse : public Course {
private:
    int months;
    int hoursPerDay;
public:
    OfflineCourse(int m, int h) {
        months = m;
        hoursPerDay = h;
    }

    void duration() override {
        cout << "Offline Course Duration: "
            << months << " months" << endl;

        cout << "Total Study Hours (assuming 30 days per month): "
            << months * 30 * hoursPerDay << " hours" << endl;
    }
};

int main() {
    OnlineCourse online(8, 5);
    OfflineCourse offline(3, 4);
    Course* c1 = &online;
    Course* c2 = &offline;

    c1->duration();
    cout << endl;
    c2->duration();
    return 0;
}
